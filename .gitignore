.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# never commit anything with real money or creds in it
# anchored to the repo root: cctrack/data/ holds packaged seed files that must
# ship, and an unanchored `data/` silently swallowed them
/data/
/downloads/
*.db
*.db-wal
*.db-shm
.env
.direnv/

# real bank exports stay local; only the redacted fixture is tracked
fixtures/cibc_*.csv
!fixtures/cibc_sample_redacted.csv

# playwright persistent browser profile (holds CIBC session cookies)
browser/

# fasthtml writes its session-signing key here on first run
.sesskey
result
result-*
